{
  // Настройки проверки типов. Сам TypeScript ничего не собирает (noEmit): собирает Vite.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    // .js и .ts живут вместе: переводим файлы постепенно. Старые .js пока не проверяем
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  // tests добавим, когда движок переедет на TypeScript: пока у движка нет типов, и проверка на тестах ругается впустую
  "include": ["js", "tools", "vite.config.ts"]
}
